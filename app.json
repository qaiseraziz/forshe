{
  "expo": {
    "name": "ForSHE",
    "slug": "forshe",
    "version": "1.2.17",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#f5f0eb"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forshe.app",
      "buildNumber": "24",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow ForSHE to use your location to calculate accurate prayer times.",
        "NSContactsUsageDescription": "Allow ForSHE to read your contacts so you can quickly add vendors from your address book."
      }
    },
    "android": {
      "package": "com.forshe.app",
      "versionCode": 24,
      "adaptiveIcon": {
        "backgroundColor": "#c8860a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c8860a"
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ForSHE to access your photos for receipt attachments."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ForSHE to use your location to calculate accurate prayer times.",
          "locationWhenInUsePermission": "Allow ForSHE to use your location to calculate accurate prayer times.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "owner": "smartbzsss-organization",
    "extra": {
      "eas": {
        "projectId": "dc6a60ae-938e-4194-8ae8-a8c811759a40"
      }
    }
  }
}
